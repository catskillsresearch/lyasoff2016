theorem dufresne_theorem (P : Measure Ω) [IsProbabilityMeasure P] (W : ℝ≥0 → Ω → ℝ)
    (hW : IsBM P W) (σ ν : ℝ) (hσ : 0 < σ) (hν : ν < 0) :
    IsInftyDensity P W σ ν (dufresne σ ν) := by

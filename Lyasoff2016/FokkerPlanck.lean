        σ ^ 2 * x' ^ 2 / 2 * deriv (fun z => φ z y) x'
          + σ * x' * deriv (fun y' => φ x' y') y
          + (Real.exp (σ * y) + σ ^ 2 * x' / 2 - 1) * φ x' y) x = 0 := by
